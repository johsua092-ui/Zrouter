{
    "name": "Zrouter",
    "version": "0.1.3",
    "description": "High-performance multi-provider AI Gateway and LLM proxy router built with Hono, TypeScript, and SQLite WAL",
    "author": "ZelApi",
    "license": "MIT",
    "type": "module",
    "private": true,
    "repository": {
        "type": "git",
        "url": "https://github.com/zelapii/Zrouter.git"
    },
    "keywords": [
        "ai-gateway",
        "llm-proxy",
        "openai-compatible",
        "anthropic-compatible",
        "hono",
        "sqlite",
        "antigravity",
        "gemini",
        "claude",
        "chatgpt",
        "router"
    ],
    "homepage": "https://github.com/zelapii/Zrouter#readme",
    "bugs": {
        "url": "https://github.com/zelapii/Zrouter/issues"
    },
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "dev": "concurrently -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
        "dev:api": "pnpm --filter api dev",
        "dev:web": "pnpm --filter web dev",
        "start": "node apps/api/dist/index.js",
        "build": "pnpm --filter @srouter/types build && pnpm --filter @srouter/pricing build && pnpm --filter @srouter/constants build && pnpm --filter @srouter/translator build && pnpm --filter @srouter/db build && pnpm --filter @srouter/executors build && pnpm --filter @srouter/providers build && pnpm --filter web build && pnpm --filter api build",
        "build:api": "pnpm --filter api build",
        "build:web": "pnpm --filter web build",
        "clean": "rm -rf apps/*/dist packages/*/dist",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "engines": {
        "node": ">=22.0.0"
    },
    "dependencies": {
        "@xyflow/system": "^0.0.80"
    },
    "devDependencies": {
        "concurrently": "^9.1.2",
        "csstype": "^3.1.0",
        "prettier": "^3.5.0",
        "typescript": "^5.8.3"
    }
}
